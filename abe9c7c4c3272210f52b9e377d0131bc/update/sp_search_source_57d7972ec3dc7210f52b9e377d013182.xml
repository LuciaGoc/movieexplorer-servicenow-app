        <search_page_template><![CDATA[<!-- me header -->
<sp-widget widget-id="ff7173679743ba103c50f91de053afb6"></sp-widget>
<div class="movie-card">
  <!-- Klikatelny poster -->
  <a ng-href="{{item.url}}" class="movie-poster">
    <img ng-src="{{item.poster_url}}" alt="{{item.title}}">
  </a>

  <!-- Textovy obsah -->
  <div class="movie-text">

    <!-- Klikateľný názov filmu -->
    <a ng-href="{{item.url}}" class="h4 text-primary movie-title">
      <span ng-bind-html="highlight(item.title, data.q)"></span>
    </a>

    <!-- Datum vydania -->
    <div ng-if="item.release_date" class="movie-release-date">
      {{ item.release_date | date:'MMMM d, yyyy' }}
    </div>

    <!-- Wrapper pre popis -->
    <p class="movie-description" ng-bind-html="item.description"></p>
  </div>
</div>

<!-- responzivne CSS -->
<style>
  /* Kontajner pre kartu filmu */
  .movie-card {
    display: flex;
    flex-wrap: wrap;
    margin-bottom: 20px;
    padding-bottom: 15px;
    align-items: flex-start;
  }

  .movie-poster {
    flex: 0 0 92px;
    margin-right: 10px;
  }

  .movie-poster img {
    width: 100%;
    border-radius: 5px;
    object-fit: cover;
  }

  .movie-text {
    flex: 1 1 0;
    min-width: 150px;
  }

  .movie-title {
    display: block;
    margin-bottom: 3px;
    font-size: 14px;
    white-space: normal;
    word-break: break-word;
  }

  .movie-release-date {
    font-size: 12px;
    color: #777;
    margin-bottom: 10px;
  }

  /* Popis - defaultne 3 riadky */
  .movie-description {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 2px 0;
    color: #555;
    font-size: 12px;
    line-height: 1.2em;
  }

  /* Pri strednych obrazovkach: 2 riadky */
  @media (max-width: 600px) {
    .movie-description {
      -webkit-line-clamp: 2;
    }
  }

  /* Pri malych obrazovkach: 1 riadok */
  @media (max-width: 400px) {
    .movie-description {
      -webkit-line-clamp: 1;
    }

    .movie-card img {
      width: 70px;
    }
  }
</style>]]></search_page_template>
