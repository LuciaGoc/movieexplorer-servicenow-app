        <advanced_typeahead_config>false</advanced_typeahead_config>
        <condition/>
        <data_fetch_script><![CDATA[(function(query) {
    gs.info("Movie Explorer Table Search called with query: " + query);

    var results = [];

    var gr = new GlideRecord('x_1080820_mvx_movie');
    if (!gr.isValid()) { // skontroluje, či tabuľka existuje
        return results;
    }
	var searchFields = ['title', 'original_title', 'festival_title'];

    var queryStr = searchFields.map(function(field) {
        return field + "LIKE" + query;
    }).join("^OR");

    gr.addEncodedQuery(queryStr);

    //gr.addNotNullQuery('poster_url');
    gr.addNotNullQuery('description');
	gr.orderByDesc('release_date');
	gr.setLimit(10);
 
    gr.query();

    while (gr.next()) {
        results.push({
            table: 'x_1080820_mvx_movie',
            sys_id: gr.getValue('sys_id'),
            title: gr.getValue('title'),
            release_date: gr.getValue('release_date'),
            poster_url: gr.getValue('poster_url'),
            description: gr.getValue('description'),

			url: '?id=movie_detail&sys_id=' + gr.getValue('sys_id')
        });
    }

    return results;
})(query);]]></data_fetch_script>
        <display_fields/>
        <enable_typeahead>true</enable_typeahead>
