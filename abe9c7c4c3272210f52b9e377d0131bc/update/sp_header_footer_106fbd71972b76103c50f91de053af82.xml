        <template><![CDATA[<div class="me-header-container header">

  <!-- LEFT: LOGO -->
  <div class="me-header-left">
    <a href="/mep">
      <img src="/sys_attachment.do?sys_id=fd34c87a97d3f2103c50f91de053af32"
           alt="Movie Explorer Logo">
    </a>
  </div>
  <!-- CENTER: NAVIGATION -->
  <div class="me-header-center">
    <nav class="me-header-nav">
      <a href="/mep" class="active">Movies</a>
      <a href="/mep?id=search&t=movie_explorer_people_search&q=a">People</a>
      <a href="#">Reviews</a>

      <div class="dropdown">
        <a href="javascript:void(0)">More ▼</a>

        <div class="dropdown-content">
          <a href="javascript:void(0)">TV Shows</a>
          <a href="javascript:void(0)">Awards</a>
        </div>
      </div>
    </nav>
  </div>

  <!-- RIGHT: SEARCH -->
  <div class="me-header-right">
    <input
      id="me-header-search-input"
      type="text"
      placeholder="Search movies..."
      class="me-search-input">

    <button
      id="me-header-search-btn"
      class="me-search-btn">
      Search
    </button>
  </div>

</div>

&lt;script&gt;
  (function() {

  console.log('ME header script loaded');

  function runMovieSearch() {
    console.log('runMovieSearch called');

    var input = document.getElementById('me-header-search-input');

    if (!input) return;

    var q = (input.value || '').trim();

    if (!q) return;

    window.location.href =
      '/mep?id=search&q=' + encodeURIComponent(q);
  }

  setTimeout(function() {

    var input = document.getElementById('me-header-search-input');
    var btn = document.getElementById('me-header-search-btn');

    if (btn) {
      btn.addEventListener('click', runMovieSearch);
    }

    if (input) {
      input.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
          runMovieSearch();
        }
      });
    }

  }, 100);

})();
&lt;/script&gt;]]></template>
